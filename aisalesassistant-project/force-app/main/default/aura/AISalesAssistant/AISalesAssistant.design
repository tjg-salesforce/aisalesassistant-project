    <design:attribute name="noTouch3ButtonLink" label="[5. NO TOUCH] ITEM 3 - Button Link" description="URL to navigate to when button is clicked" />
    <design:attribute name="noTouch3DetailTitle" label="[5. NO TOUCH] ITEM 3 - Detail Title" description="Title for no-touch item 3 detail section" />
    <design:attribute name="noTouch3DetailContent" label="[5. NO TOUCH] ITEM 3 - Detail Content" description="Detailed content for no-touch item 3" />
